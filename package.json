{
  "name": "browser-kernel",
  "version": "0.1.0",
  "description": "A small WASI preview1 kernel with wasi-threads, for running wasm32-wasip1-threads programs in browsers and Node",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/ryancbuckley/browser-kernel.git" },
  "homepage": "https://github.com/ryancbuckley/browser-kernel#readme",
  "bugs": "https://github.com/ryancbuckley/browser-kernel/issues",
  "type": "module",
  "exports": {
    ".": "./kernel.js",
    "./fs": "./fs.js",
    "./node": "./node-host.js",
    "./browser": "./browser-host.js",
    "./thread-worker": "./thread-worker.js"
  },
  "bin": {
    "browser-kernel-run": "./run.js"
  },
  "scripts": {
    "test": "tsc -p . && node --test test/syscalls.test.mjs && node test/run.mjs",
    "test:unit": "node --test test/syscalls.test.mjs",
    "check": "tsc -p ."
  },
  "files": [
    "kernel.js",
    "fs.js",
    "thread-worker.js",
    "node-host.js",
    "browser-host.js",
    "run.js"
  ],
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
