{
  "name": "wasi-kernel",
  "version": "0.1.0",
  "description": "A small WASI preview1 kernel with wasi-threads, for running wasm32-wasip1-threads programs in browsers and Node",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./kernel.js",
    "./fs": "./fs.js",
    "./node": "./node-host.js",
    "./thread-worker": "./thread-worker.js"
  },
  "bin": { "wasi-kernel-run": "./run.js" },
  "scripts": {
    "test": "node --test test/syscalls.test.mjs && node test/run.mjs",
    "test:unit": "node --test test/syscalls.test.mjs"
  },
  "files": ["kernel.js", "fs.js", "thread-worker.js", "node-host.js", "run.js"]
}
