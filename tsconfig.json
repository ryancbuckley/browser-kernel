{
  // Type-check JavaScript files via JSDoc annotations without emitting output.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    // Allow declaring class fields that are initialized after construction (such as `Process.memory`).
    "strictPropertyInitialization": false,
    "target": "es2024",
    "module": "nodenext",
    "lib": ["es2024", "dom"],
    "types": ["node"]
  },
  "files": ["kernel.js", "fs.js", "thread-worker.js", "browser-host.js", "node-host.js", "run.js"]
}
